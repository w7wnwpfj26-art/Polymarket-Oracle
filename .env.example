# ============================================
# AEGIS Arbitrage System - Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# ---- Server ----
PORT=7700
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Authentication ----
AUTH_ENABLED=true
JWT_SECRET=your-strong-secret-key-at-least-32-chars
AEGIS_ADMIN_PASSWORD=YourStrongPassword123!
RATE_LIMIT_PER_MINUTE=200

# ---- API Keys (format: AEGIS_API_KEY_<NAME>=<key>:<role>:<rateLimit>) ----
# AEGIS_API_KEY_MYAPP=my-api-key-here:user:100
# AEGIS_API_KEY_ADMIN=admin-key-here:admin:1000

# ---- AI Provider ----
# Options: openai, anthropic, deepseek, qwen, local
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-key
# DEEPSEEK_API_KEY=your-deepseek-key

# ---- Polymarket ----
POLYMARKET_CLOB_API=https://clob.polymarket.com
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# ---- Blockchain (Polygon) ----
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_CHAIN_ID=137
# WALLET_PRIVATE_KEY=  # WARNING: Use secure key management in production

# ---- Contracts (defaults are Polygon Mainnet) ----
# USDC_CONTRACT=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
# CTF_EXCHANGE_CONTRACT=0x4bFb41d5B3570DeFd03C39a9A4D8dE6Bd8B8982E

# ---- Sentiment Analysis APIs ----
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
NEWS_API_KEY=

# ---- Traditional Odds ----
ODDS_API_KEY=

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Redis (optional, for distributed caching) ----
# REDIS_URL=redis://localhost:6379
